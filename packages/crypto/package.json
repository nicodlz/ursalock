{
  "name": "@zod-vault/crypto",
  "version": "0.2.0",
  "description": "E2EE crypto primitives for zod-vault",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup src/index.ts --format esm --dts",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@z-base/cryptosuite": "^1.0.1",
    "hash-wasm": "^4.11.0"
  },
  "devDependencies": {
    "tsup": "^8.0.0",
    "typescript": "^5.4.0",
    "vitest": "^1.6.0"
  },
  "keywords": [
    "encryption",
    "e2ee",
    "aes-256-gcm",
    "argon2id",
    "crypto",
    "zero-knowledge",
    "jwk"
  ],
  "license": "MIT",
  "author": "Nicolas de Luz <ndlz@pm.me>",
  "homepage": "https://github.com/nicodlz/zod-vault#readme",
  "bugs": {
    "url": "https://github.com/nicodlz/zod-vault/issues"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/nicodlz/zod-vault.git",
    "directory": "packages/crypto"
  }
}
