{
  "name": "@zod-vault/client",
  "version": "0.1.0",
  "description": "Auth and API client for zod-vault",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup src/index.ts --format esm --dts",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@simplewebauthn/browser": "^10.0.0"
  },
  "devDependencies": {
    "tsup": "^8.0.0",
    "typescript": "^5.4.0",
    "vitest": "^1.6.0"
  },
  "keywords": [
    "auth",
    "passkeys",
    "webauthn",
    "e2ee",
    "zod-vault"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/nicodlz/zod-vault.git",
    "directory": "packages/client"
  }
}
