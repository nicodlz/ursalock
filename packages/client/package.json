{
  "name": "@ursalock/client",
  "version": "0.2.2",
  "description": "Auth and API client for ursalock with E2EE passkey encryption",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup src/index.ts --format esm --dts",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@z-base/zero-knowledge-credentials": "^1.0.2"
  },
  "peerDependencies": {
    "react": ">=18.0.0"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/react": "^19.2.13",
    "react": "^18.3.1",
    "tsup": "^8.0.0",
    "typescript": "^5.4.0",
    "vitest": "^1.6.0"
  },
  "keywords": [
    "auth",
    "passkeys",
    "webauthn",
    "prf",
    "e2ee",
    "zero-knowledge",
    "ursalock"
  ],
  "license": "MIT",
  "author": "Nicolas de Luz <ndlz@pm.me>",
  "homepage": "https://github.com/nicodlz/ursalock#readme",
  "bugs": {
    "url": "https://github.com/nicodlz/ursalock/issues"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/nicodlz/ursalock.git",
    "directory": "packages/client"
  }
}
