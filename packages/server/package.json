{
  "name": "@ursalock/server",
  "version": "0.3.1",
  "description": "Self-hostable ursalock server with SQLite and ZKCredentials support",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "imports": {
    "#*": "./src/*"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup src/index.ts --format esm",
    "dev": "tsx watch src/server.ts",
    "start": "node dist/index.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "db:migrate": "tsx src/db/migrate.ts",
    "db:seed": "tsx src/db/seed.ts"
  },
  "dependencies": {
    "@hono/node-server": "^1.13.0",
    "@hono/zod-validator": "^0.7.6",
    "@simplewebauthn/server": "^10.0.0",
    "bcryptjs": "^3.0.3",
    "better-sqlite3": "^11.0.0",
    "hono": "^4.6.0",
    "jose": "^5.9.0",
    "zod": "^3.23.0"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/better-sqlite3": "^7.6.0",
    "tsup": "^8.0.0",
    "tsx": "^4.0.0",
    "typescript": "^5.4.0",
    "vitest": "^1.6.0"
  },
  "keywords": [
    "ursalock",
    "server",
    "e2ee",
    "sqlite",
    "hono",
    "zkc",
    "passkey"
  ],
  "license": "MIT",
  "author": "Nicolas de Luz <ndlz@pm.me>",
  "homepage": "https://github.com/nicodlz/ursalock#readme",
  "bugs": {
    "url": "https://github.com/nicodlz/ursalock/issues"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/nicodlz/ursalock.git",
    "directory": "packages/server"
  }
}
