{
  "name": "@zod-vault/zustand",
  "version": "0.1.0",
  "description": "Encrypted persistence middleware for Zustand",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup src/index.ts --format esm --dts",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@zod-vault/crypto": "^0.1.0"
  },
  "peerDependencies": {
    "zustand": ">=4.0.0"
  },
  "devDependencies": {
    "tsup": "^8.0.0",
    "typescript": "^5.4.0",
    "vitest": "^1.6.0",
    "zustand": "^5.0.0"
  },
  "keywords": [
    "zustand",
    "middleware",
    "encryption",
    "e2ee",
    "sync",
    "persist"
  ],
  "license": "MIT",
  "author": "Nicolas de Luz <ndlz@pm.me>",
  "homepage": "https://github.com/nicodlz/zod-vault#readme",
  "bugs": {
    "url": "https://github.com/nicodlz/zod-vault/issues"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/nicodlz/zod-vault.git",
    "directory": "packages/zustand"
  }
}
